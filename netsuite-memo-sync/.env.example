# ============================================================================
#  NetSuite Token-Based Authentication (TBA / OAuth 1.0) credentials
#  ----------------------------------------------------------------------------
#  Copy this file to ".env" and fill in the REAL values there.
#  .env is git-ignored and must NEVER be committed or pasted into chat.
#
#  Where to get these in NetSuite:
#    Consumer Key/Secret  -> Setup > Integration > Manage Integrations
#                            (the Integration Record / "App")
#    Token ID/Secret      -> Setup > Users/Roles > Access Tokens
#    Account ID           -> Setup > Company > Company Information
#                            (e.g. 1234567  or  1234567_SB1 for a sandbox)
# ============================================================================

NETSUITE_ACCOUNT_ID=1234567
NETSUITE_CONSUMER_KEY=your_consumer_key_here
NETSUITE_CONSUMER_SECRET=your_consumer_secret_here
NETSUITE_TOKEN_ID=your_token_id_here
NETSUITE_TOKEN_SECRET=your_token_secret_here

# Signature method NetSuite expects (leave as-is unless your integration uses SHA1)
NETSUITE_SIGNATURE_METHOD=HMAC-SHA256
